{
  "name": "junk-mountain",
  "productName": "Junk Mountain",
  "version": "0.1.0",
  "description": "Dig, sort, sell and automate your way through a mountain of junk to find a lost lottery ticket.",
  "author": "Junk Mountain",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "assets": "node tools/fetch-assets.mjs",
    "icon": "node tools/make-icon.mjs",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.junkmountain.game",
    "productName": "Junk Mountain",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Junk Mountain",
      "artifactName": "JunkMountainSetup-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "meshoptimizer": "^0.22.0",
    "sharp": "^0.33.5",
    "vite": "^5.4.11"
  }
}
